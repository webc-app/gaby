# Copier ce fichier en « .env » et le remplir. Le fichier .env n'est jamais mis dans git ni en ligne.

# Mise en ligne (scripts/deploy-test.sh)
DEPLOY_SSH=utilisateur@serveur.exemple.fr
DEPLOY_DOSSIER=/chemin/vers/le/dossier/web
DEPLOY_ADRESSE=https://mon-site.exemple.fr

# Mentions légales, affichées dans les réglages (laisser vide ce qui ne s'applique pas)
VITE_EDITEUR="Nom ou raison sociale, adresse (un particulier non professionnel peut rester anonyme : description et contact suffisent)"
CONTACT=contact@exemple.fr
VITE_HEBERGEUR="Nom de l'hébergeur, adresse"
VITE_DEPOT=https://github.com/utilisateur/gaby

# Voix ElevenLabs (facultatif, voir scripts/voix.mjs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID_FR=
# ELEVENLABS_VOICE_ID_EN=
